# Локальные переменные для scripts/dev-server.mjs (скопируйте в .env — он в .gitignore).
#
# API-ключи провайдеров (Supadata / Gemini / Groq / Pixabay / Giphy)
# задаются в приложении: Настройки → «Карточки из YouTube» / стоковые медиа.
# Сервер НЕ подставляет ключи из .env — без ключа в UI запросы к /api/* вернут 401.

# Опционально — только имена моделей (не секреты биллинга):
# GEMINI_MODEL=gemini-flash-latest
# GROQ_MODEL=

# --- Аутентификация /api/* (functions/api/_middleware.js) ---
#
# Bearer = JWT Cloudflare sync (iss: kar-cf-sync), секрет SYNC_JWT_SECRET.
# Без Authorization — аноним (IP + X-Client-Id).
# SUPABASE_* больше не используются.

# Прод rate-limit (wrangler.toml [vars] REQUIRE_RATE_LIMIT=1):
# без биндинга YT_JOBS /api/* отвечает 503. Локально pages:dev уже с --kv.

# Chrome-расширение для своего домена:
# KAR_EXT_APP_ORIGIN=https://your.domain npm run ext:build

# --- /api/translate: Azure Translator (опционально) ---
# AZURE_TRANSLATOR_KEY=
# AZURE_TRANSLATOR_REGION=

# --- Cloudflare D1 sync ---
# wrangler d1 create kar-sync → database_id в wrangler.toml
# npm run d1:migrate:remote
# Pages Secret: SYNC_JWT_SECRET (случайная строка ≥32 символов)

# --- Cloudflare R2 images ---
# wrangler r2 bucket create kar-card-images
# binding CARD_IMAGES уже в wrangler.toml
# Тот же SYNC_JWT_SECRET подписывает GET /api/files
