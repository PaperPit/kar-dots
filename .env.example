# Локальные переменные для scripts/dev-server.mjs (скопируйте в .env — он в .gitignore).
#
# API-ключи провайдеров (Supadata / Gemini / Groq / Pixabay / Giphy)
# задаются в приложении: Настройки → «Карточки из YouTube» / стоковые медиа.
# Сервер НЕ подставляет ключи из .env — без ключа в UI запросы к /api/* вернут 401.
#
# Опционально — только имена моделей (не секреты биллинга):
# GEMINI_MODEL=gemini-flash-latest
# GROQ_MODEL=

# --- Проверка входа для /api/* (functions/api/_middleware.js) ---
#
# Нужны, когда клиент шлёт `Authorization: Bearer <access-token Supabase>`:
# middleware проверяет токен запросом GET ${SUPABASE_URL}/auth/v1/user
# с заголовком apikey: ${SUPABASE_ANON_KEY}. Без этих переменных запрос
# с Authorization получит 503 (молча считать токен валидным нельзя).
# Запросы БЕЗ Authorization работают как раньше — приложение поддерживает
# локальные аккаунты, для них субъект считается от IP + X-Client-Id.
#
# Обе величины публичные по замыслу Supabase: anon key и так уходит в браузер
# вместе с бандлом (js/config.js), это не новый секрет. service_role key сюда
# класть НЕЛЬЗЯ.
#
# В проде задаются в Cloudflare Pages → Settings → Environment variables
# (обычные переменные, не Secrets — они не секретные).
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_ANON_KEY=<anon public key того же проекта>
#
# Прод rate-limit (wrangler.toml [vars] REQUIRE_RATE_LIMIT=1):
# без биндинга YT_JOBS /api/* отвечает 503. Локально pages:dev уже с --kv.
#
# Chrome-расширение для своего домена:
# KAR_EXT_APP_ORIGIN=https://your.domain npm run ext:build
