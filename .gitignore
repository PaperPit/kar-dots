# Локальные ключи Supabase (скопируйте config.example.js → config.js)
js/config.js

# Локальные переменные окружения (API-ключи) — не коммитить!
.env
.dev.vars
.wrangler/
.vercel/

# Зависимости и сборка
node_modules/

# ОС и редактор
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/
.cursor/

# Локальные артефакты AI/дизайн-агентов и аналитики
.interface-design/
opencode.json
outputs/

# Генерируется для Capacitor командой npm run ios:prepare
www/

# Артефакты E2E-тестов
test-results/
playwright-report/

# Coverage (vitest --coverage)
coverage/

# Graphify
graphify-out/

# Исходники для scripts/build-vocab-packs.py (скачиваются отдельно)
scripts/data/

# Резервная копия альтернативной реализации YouTube-импорта (можно удалить после ревью)
_backup_alt_youtube_impl/
_to_delete/

# Сборка TypeScript: компилируется на место в js/ — игнорируем .js рядом с .ts,
# но оставляем исходники vendor (.mjs) и config.example.js
js/**/*.js
!js/vendor/
!js/vendor/*.mjs
!js/config.example.js
*.tsbuildinfo

# Прод-бандл (esbuild -> dist/). Только корень репо —
# extension/dist/*.js коммитим для Chrome «Load unpacked» без локальной сборки.
/dist/

# Sourcemaps сборки Chrome-расширения
extension/dist/*.map

# Кэш и артефакты Python-скриптов (scripts/*.py)
__pycache__/
*.pyc
*.pyo

# Архивы и снапшоты для ручного деплоя — не хранить в репозитории
# (внутри легко оседают ключи Supabase и устаревшая схема БД)
*.zip
*.tar
*.tar.gz
*.tgz

# Отчёт сканера локализации
scripts/i18n-report.json
