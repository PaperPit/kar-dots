{
  "manifest_version": 3,
  "name": "КАР-точки — YouTube",
  "description": "Создавай карточки из YouTube-роликов прямо на странице видео.",
  "version": "1.1.0",
  "minimum_chrome_version": "120",
  "icons": {
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png",
    "192": "icons/icon-192.png"
  },
  "action": {
    "default_title": "КАР-точки",
    "default_popup": "sidepanel/index.html",
    "default_icon": {
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "dist/background.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://youtube.com/*",
    "https://kar-tochki.pages.dev/*",
    "https://*.supabase.co/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://youtube.com/*"
      ],
      "js": [
        "dist/content-youtube.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://kar-tochki.pages.dev/*"
      ],
      "js": [
        "dist/content-app-bridge.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
